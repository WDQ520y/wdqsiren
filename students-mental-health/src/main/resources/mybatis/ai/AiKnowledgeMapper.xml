<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mentalhealth.project.system.ai.mapper.AiKnowledgeMapper">

    <resultMap id="AiKnowledgeResult" type="com.mentalhealth.project.system.ai.domain.AiKnowledge">
        <id     property="id"       column="id"/>
        <result property="title"    column="title"/>
        <result property="category" column="category"/>
        <result property="content"  column="content"/>
        <result property="keywords" column="keywords"/>
        <result property="status"   column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectList" parameterType="com.mentalhealth.project.system.ai.domain.AiKnowledge" resultMap="AiKnowledgeResult">
        SELECT * FROM ai_knowledge_base
        <where>
            <if test="title != null and title != ''">AND title LIKE CONCAT('%',#{title},'%')</if>
            <if test="category != null and category != ''">AND category = #{category}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="AiKnowledgeResult">
        SELECT * FROM ai_knowledge_base WHERE id = #{id}
    </select>

    <insert id="insertKnowledge" parameterType="com.mentalhealth.project.system.ai.domain.AiKnowledge">
        INSERT INTO ai_knowledge_base (title, category, content, keywords, status, create_time)
        VALUES (#{title}, #{category}, #{content}, #{keywords}, #{status}, NOW())
    </insert>

    <update id="updateKnowledge" parameterType="com.mentalhealth.project.system.ai.domain.AiKnowledge">
        UPDATE ai_knowledge_base
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="category != null">category = #{category},</if>
            <if test="content != null">content = #{content},</if>
            <if test="keywords != null">keywords = #{keywords},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ai_knowledge_base WHERE id = #{id}
    </delete>

    <select id="searchByKeywords" resultMap="AiKnowledgeResult">
        SELECT * FROM ai_knowledge_base
        WHERE status = '0'
        AND (
            keywords LIKE CONCAT('%', #{keywords}, '%')
            OR title LIKE CONCAT('%', #{keywords}, '%')
            OR content LIKE CONCAT('%', #{keywords}, '%')
        )
        ORDER BY id DESC
        LIMIT 3
    </select>

    <select id="selectAllEnabled" resultMap="AiKnowledgeResult">
        SELECT * FROM ai_knowledge_base WHERE status = '0' ORDER BY id
    </select>

</mapper>
